+/// Soft Back with an empty in-app stack: background the task (do not finish()).
+pub unsafe fn to_java_move_task_to_back(env: *mut jni_sys::JNIEnv) {
+    ndk_utils::call_void_method!(env, get_activity(), "moveTaskToBackFromNative", "()V");
+}
+
+/// Cold GL program cache: show Makepad PR #1432 "Compiling shaders" on the cover.
+pub unsafe fn to_java_show_shader_compile_screen() {
+    let env = attach_jni_env();
+    ndk_utils::call_void_method!(env, get_activity(), "showShaderCompileScreen", "()V");
+}
+
 pub unsafe fn to_java_switch_activity(env: *mut jni_sys::JNIEnv) {
